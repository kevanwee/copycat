# Export these into the backend process; settings do not auto-load this file.
COPYCAT_DATABASE_URL=sqlite:///./data/copycat.db
COPYCAT_STORAGE_ROOT=./data/uploads
COPYCAT_REPORT_ROOT=./data/reports
COPYCAT_CELERY_TASK_ALWAYS_EAGER=true
COPYCAT_FRONTEND_BASE_URL=http://localhost:3000
COPYCAT_MAX_TEXT_MB=10
COPYCAT_MAX_TEXT_TOKENS=20000
COPYCAT_MAX_IMAGE_MB=20
COPYCAT_MAX_VIDEO_MB=100
COPYCAT_MAX_VIDEO_SECONDS=300
COPYCAT_MAX_ACTIVE_JOBS=2
COPYCAT_RETENTION_HOURS=24
COPYCAT_CLEANUP_INTERVAL_SECONDS=300
COPYCAT_SCORING_VERSION=v2.0.0
COPYCAT_RULE_PACK_VERSION=sg_v2
COPYCAT_FFMPEG_BIN=ffmpeg
COPYCAT_FFPROBE_BIN=ffprobe
# Frontend: put this in frontend/.env.local before building.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
